{
  "name": "pipeline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Client acquisition pipeline: source -> qualify -> demo -> outreach",
  "scripts": {
    "chain-index": "tsx bin/build-chain-index.ts",
    "source": "tsx bin/source-area.ts",
    "campaign": "tsx bin/campaign.ts",
    "console": "tsx bin/console.ts",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.e2e.json",
    "verify": "tsx bin/verify-leads.ts",
    "worklist": "tsx bin/worklist.ts",
    "new-demo": "tsx bin/new-demo.ts",
    "draft": "tsx bin/draft-outreach.ts",
    "sent": "tsx bin/mark-sent.ts",
    "record": "tsx bin/record.ts",
    "publish": "tsx bin/publish.ts",
    "mockup": "tsx bin/mockup.ts",
    "harvest": "tsx bin/harvest-assets.ts",
    "palette": "python bin/sample-palette.py",
    "doctor": "tsx bin/doctor.ts",
    "pipeline": "tsx bin/pipeline.ts",
    "e2e": "tsx --test --test-reporter=spec \"test/e2e/pipeline.e2e.ts\"",
    "test:ui": "tsx --test --test-reporter=spec --test-concurrency=1 \"test/e2e/dashboard.e2e.ts\"",
    "lint": "eslint .",
    "build": "tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@types/node": "^22",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "html-validate": "^11.16.0",
    "tsx": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.70.1"
  },
  "dependencies": {
    "googleapis": "^178.0.0",
    "playwright": "^1.62.1",
    "sharp": "^0.34.5",
    "undici": "^8.10.1",
    "zod": "^4.6.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "sharp@0.34.5": true
  }
}
