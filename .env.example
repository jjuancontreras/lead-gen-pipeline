# Copy this file to .env.local and fill in what you have.
#   cp .env.example .env.local
#
# .env.local is gitignored. Everything here is OPTIONAL - the pipeline runs
# without any of it, just with fewer features. Run `npm run doctor` to see
# exactly what is on and what each missing key costs you.
#
# A real shell environment variable always overrides this file.

# --- Gemini (free tier, NO credit card) -------------------------------
# https://aistudio.google.com/apikey
# Unlocks: photo curation, menu-graphic OCR, brand description.
# Without it photos still download; only the AI curation is skipped.
GEMINI_API_KEY= 

# --- Google Sheets store ----------------------------------------------
# Switches the lead store from local JSON to a shared Sheet.
# BOTH must be set or it stays on JSON.
# Sheet ID is the long string in the URL:
#   docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEET_ID=
# Absolute path to the service-account JSON key you downloaded.
# Keep it OUTSIDE the repo and OneDrive, e.g. C:\Users\<you>\.secrets\<key>.json
GOOGLE_SA_KEY_PATH=
# Optional. Defaults to "Leads".
GOOGLE_SHEET_TAB=

# --- Gmail drafts ------------------------------------------------------
# Absolute path to a stored OAuth refresh token.
# Without it, outreach is written to data/drafts/ for manual copy-paste.
# NOTHING IS EVER SENT AUTOMATICALLY either way - drafts only.
GMAIL_TOKEN_PATH=

# --- Work Queue (npm run console, then /queue) -------------------------
# Who the Tier-2 pitch email is from. Pitch drafts refuse until this is set.
SENDER_EMAIL=
# Optional. Defaults to the name in src/outreach.ts (SENDER).
SENDER_NAME=
# Optional. Live demos linked in first-contact emails, comma-separated,
# e.g. https://kuro-demo.vercel.app,https://gotbaked.vercel.app
PORTFOLIO_URLS=
# Where the hand-built Next.js demos live (Build demo, Record, harvest,
# publish). Defaults to the folder above this repo, which is WRONG since the
# repo moved out of OneDrive: set it to your Websites folder.
DEMO_SITES_ROOT=
# Must stay false. Nothing in this codebase sends; true is refused at startup.
SEND_EMAILS=false
# Optional: target length of a Record walkthrough in ms (default 27000).
PIPELINE_VIDEO_MS=
# Optional: where the JSON store and drafts live (default ./data), and json
# to keep the store off the Google Sheet (the tests use both).
PIPELINE_DATA_DIR=
PIPELINE_STORE=
# Optional: pretty | json, and debug | info | warn | error.
LOG_FORMAT=
LOG_LEVEL=